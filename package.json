{
  "name": "cv",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tests",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db-migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/db-seed.ts",
    "admin:create": "node --env-file-if-exists=.env.local --import tsx scripts/admin-create.ts",
    "assets:posters": "node --import tsx scripts/posters.ts",
    "assets:textures": "node --import tsx scripts/textures.ts",
    "perf:local": "playwright test -c playwright.perf.config.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.5",
    "@react-three/fiber": "9.8.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.9",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.3",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "n8ao": "2.0.1",
    "next": "16.3.6",
    "next-intl": "4.14.6",
    "pg": "8.23.0",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.9.5",
    "react-markdown": "10.1.0",
    "resend": "6.28.1",
    "sharp": "0.35.4",
    "three": "0.186.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@electric-sql/pglite": "0.5.8",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "drizzle-kit": "0.31.11",
    "otpauth": "9.5.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
